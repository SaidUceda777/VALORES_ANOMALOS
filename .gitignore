# ══════════════════════════════════════════════════════════════
# .gitignore — Tesis: Detección de variaciones en valor unitario
# ══════════════════════════════════════════════════════════════

# ── Notebooks excluidos (trabajo en progreso / borradores) ────
notebooks/04_decision/
notebooks/05_interpretacion/
notebooks/06_optimizacion/

# ── Guía interna del curso (no va al repositorio) ─────────────
GUIA/
data/EXPORTACIONES.txt  
data/EXPORTACIONES_LIMPIO_UTF8.txt 
# ── Figuras generadas automáticamente ────────────────────────
notebooks/**/*.png
*.png

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Entornos virtuales ────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ── Variables de entorno y secretos ──────────────────────────
.env
*.env
secrets.ini
config_local.py

# ── Jupyter checkpoints ───────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Sistema operativo ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
comandos.txt